{
  "name": "zhiju-business-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "architecture": "node tools/architecture/check-boundaries.mjs",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "contracts:check": "node tools/contracts/check-catalog.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm architecture && pnpm contracts:check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
