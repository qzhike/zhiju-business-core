{
  "name": "zhiju-business-core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.19.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "architecture": "node tools/architecture/check-boundaries.mjs",
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "contracts:baseline:generate": "node --experimental-strip-types tools/contracts/generate-baseline.mts",
    "contracts:check": "node tools/contracts/generate-public-api.mjs --check && node --experimental-strip-types tools/contracts/generate-typescript-types.mts --check && node tools/contracts/check-catalog.mjs && node --experimental-strip-types tools/contracts/check-compatibility.mts",
    "contracts:generate": "node tools/contracts/generate-public-api.mjs && node --experimental-strip-types tools/contracts/generate-typescript-types.mts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm architecture && pnpm contracts:check && pnpm persistence:gate",
    "persistence:gate": "node tools/persistence/gate.mjs",
    "persistence:gate:diagnostics": "node tools/persistence/gate.mjs --diagnostics"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "24.13.3",
    "@types/pg": "8.15.5",
    "eslint": "10.8.1",
    "kysely": "0.29.5",
    "pg": "8.23.0",
    "prettier": "3.9.6",
    "testcontainers": "12.1.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10",
    "@zhiju/contracts": "workspace:*",
    "@zhiju/artifact": "workspace:*",
    "@zhiju/enterprise-project": "workspace:*",
    "@zhiju/identity-policy": "workspace:*",
    "@zhiju/integration-gateway": "workspace:*",
    "@zhiju/quality-governance": "workspace:*",
    "@zhiju/release-publication": "workspace:*",
    "@zhiju/shared-kernel": "workspace:*",
    "@zhiju/task-execution": "workspace:*"
  }
}
