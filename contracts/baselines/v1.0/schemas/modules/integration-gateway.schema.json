      "enum": [
        "FAILED",
        "UNKNOWN"
      ]
    },
    "feishuDeliveryRequest": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "deliveryMode": {
                "enum": [
                  "REPLY",
                  "REPLY_IN_THREAD"
                ]
              }
            },
            "required": [
              "deliveryMode"
            ]
          },
          "then": {
            "properties": {
              "replyToExternalRef": {
                "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/externalRef"
              }
            },
            "required": [
              "replyToExternalRef"
            ]
          }
        }
      ],
      "properties": {
        "attachmentRefs": {
          "items": {
            "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/representationRef"
