          "type": "array",
          "uniqueItems": true
        },
        "replyToExternalRef": {
          "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/externalRef"
        },
        "requestedAt": {
          "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/utcInstant"
        },
        "sourceBusinessRef": {
          "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/typedReference"
        },
        "stableIdempotencyKey": {
          "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/nonEmptyString"
        }
      },
      "required": [
        "sourceBusinessRef",
        "destinationBindingRef",
        "recipientRefs",
        "contentContractRef",
        "attachmentRefs",
        "stableIdempotencyKey",
        "requestedAt",
        "deliveryPolicyRef"
      ],
      "type": "object"
    },
