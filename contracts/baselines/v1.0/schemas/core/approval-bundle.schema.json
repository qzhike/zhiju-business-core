          "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/separationOfDutiesOutcome"
        },
        "violatedRules": {
          "items": {
            "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/nonEmptyString"
