          },
          "type": "array",
          "uniqueItems": true
        },
        "dismissedIssueRefs": {
          "items": {
            "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/typedReference"
          },
          "type": "array",
          "uniqueItems": true
        },
        "openBlockingIssueRefs": {
          "items": {
            "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/typedReference"
          },
          "type": "array",
