        },
        "openNonBlockingIssueRefs": {
          "items": {
            "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/typedReference"
          },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "openBlockingIssueRefs",
        "openNonBlockingIssueRefs",
        "closedIssueRefs",
        "dismissedIssueRefs"
