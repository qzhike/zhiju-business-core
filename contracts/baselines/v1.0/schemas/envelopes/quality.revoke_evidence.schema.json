{
  "$id": "https://schemas.zhiju.local/api/1.0/quality.revoke_evidence",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actor": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/typedReference"
    },
    "authorizationDecisionRef": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/typedReference"
    },
    "causationId": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/uuidV7"
    },
    "commandId": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/uuidV7"
    },
    "commandType": {
      "const": "quality.revoke_evidence"
    },
    "commandVersion": {
      "const": "1.0"
    },
    "correlationId": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/uuidV7"
    },
    "deadline": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/utcInstant"
