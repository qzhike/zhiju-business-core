  "required": [
    "commandId",
    "commandType",
    "commandVersion",
    "scopeRef",
    "targetRef",
    "actor",
    "authorizationDecisionRef",
    "idempotencyKey",
    "correlationId",
    "requestedAt",
    "payload",
    "integrity"
