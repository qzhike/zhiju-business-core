    "idempotencyKey": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/nonEmptyString"
    },
    "integrity": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/integrity"
    },
    "payload": {
      "$ref": "https://schemas.zhiju.local/modules/quality-governance/1.0#/$defs/quality_revoke_evidence_payload"
