    },
    "scopeRef": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/scopeRef"
    },
    "targetRef": {
      "$ref": "https://schemas.zhiju.local/common/1.0#/$defs/objectRef"
    }
