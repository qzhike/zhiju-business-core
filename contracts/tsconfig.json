{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "rewriteRelativeImportExtensions": true
  },
  "include": [
    "src/**/*.ts",
    "src/generated/payload-guard-policies.json",
    "src/generated/policy-profiles.json",
    "src/generated/company-startup-profiles.json",
    "src/generated/evaluator-profiles.json",
    "src/generated/task-execution-creation-purposes.json",
    "src/generated/work-order-ready-profiles.json",
    "src/generated/artifact-execution-schemas.json",
    "src/generated/artifact-markdown-schemas.json"
  ],
  "references": [
    {
      "path": "../packages/shared-kernel"
    }
  ]
}
