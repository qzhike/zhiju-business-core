                "minItems": 1,
                "type": "array"
              },
              "attentionItemIds": {
                "minItems": 1,
                "type": "array"
              }
            }
          }
        }
      ]
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "type": "string",
          "enum": [
            "PASS",
            "FAIL",
            "LIMITED",
            "NOT_RUN"
          ]
        },
