        "title",
        "result",
        "method",
        "scope",
        "limitations",
        "evidenceIds",
        "authority"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "LIMITED",
                  "NOT_RUN"
                ]
              }
            },
            "required": [
